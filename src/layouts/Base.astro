---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Find printmaking lessons that fit your classroom.' } = Astro.props;
const fullTitle = title ? `${title} · Teach Printmaking` : 'Teach Printmaking';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Prototype: keep search engines out until launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Teach Printmaking</a>
        <nav class="site-nav" aria-label="Main">
          <a href="/">Find a lesson</a>
          <a href="/lessons/">All lessons</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Lessons on Teach Printmaking are shared under{' '}
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>. Share and adapt them with
          credit, not for sale, and under the same terms. Sources and credits are listed on each lesson.
        </p>
        <p>Prototype. Lessons marked “Demo” are placeholder content for testing.</p>
      </div>
    </footer>
  </body>
</html>
