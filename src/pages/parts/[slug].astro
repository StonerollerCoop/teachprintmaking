---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { allLessons, lessonUrl } from '../../lib/lessons';
import { timeline } from '../../data/timeline';

export async function getStaticPaths() {
  const parts = (await getCollection('parts')).sort((a, b) => a.data.order - b.data.order);
  return parts.map((part, i) => ({
    params: { slug: part.id },
    props: { part, prev: parts[i - 1], next: parts[i + 1] },
  }));
}

interface Props {
  part: CollectionEntry<'parts'>;
  prev?: CollectionEntry<'parts'>;
  next?: CollectionEntry<'parts'>;
}
const { part, prev, next } = Astro.props;
const { Content } = await render(part);
const lessons = await allLessons();
const lessonTitles = new Map(lessons.map((l) => [l.id, l.data.title]));
const entries = part.data.timeline.map((id) => {
  const e = timeline.find((t) => t.id === id);
  if (!e) throw new Error(`Part ${part.id} links to missing timeline entry "${id}"`);
  return e;
});
for (const slug of part.data.lessons)
  if (!lessonTitles.has(slug)) throw new Error(`Part ${part.id} links to missing lesson "${slug}"`);
---

<Base title={part.data.title} description={part.data.tagline}>
  <article class="part">
    <p class="muted"><a href="/parts/">The parts of a print</a> · {part.data.order} of 5</p>
    <h1>{part.data.title}</h1>
    <p class="lede">{part.data.tagline}</p>
    <div class="lesson-body"><Content /></div>

    {part.data.lessons.length > 0 && (
      <>
        <h2>Lessons that explore this</h2>
        <ul>{part.data.lessons.map((slug) => <li><a href={lessonUrl(slug)}>{lessonTitles.get(slug)}</a></li>)}</ul>
      </>
    )}
    {entries.length > 0 && (
      <>
        <h2>In the timeline</h2>
        <ul>{entries.map((e) => <li><a href={`/history/#${e.id}`}>{e.title}</a> <span class="muted">({e.when})</span></li>)}</ul>
      </>
    )}

    <nav class="part-nav no-print" aria-label="Other parts">
      {prev ? <a href={`/parts/${prev.id}/`}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/parts/${next.id}/`}>{next.data.title} →</a> : <span></span>}
    </nav>
  </article>
</Base>
