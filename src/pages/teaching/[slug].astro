---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import LessonCard from '../../components/LessonCard.astro';
import SourceCards from '../../components/SourceCards.astro';
import ChecksBox from '../../components/ChecksBox.astro';
import ImageCards from '../../components/ImageCards.astro';
import { allLessons } from '../../lib/lessons';
import { allTypes, processUrl } from '../../lib/types';

export async function getStaticPaths() {
  const pages = (await getCollection('teaching')).sort((a, b) => a.data.order - b.data.order);
  return pages.map((page, i) => ({
    params: { slug: page.id },
    props: { page, prev: pages[i - 1], next: pages[i + 1] },
  }));
}

interface Props {
  page: CollectionEntry<'teaching'>;
  prev?: CollectionEntry<'teaching'>;
  next?: CollectionEntry<'teaching'>;
}
const { page, prev, next } = Astro.props;
const d = page.data;
const { Content } = await render(page);
const lessons = await allLessons();
const { families, processes } = await allTypes();

const pageLessons = d.lessons.map((slug) => {
  const l = lessons.find((x) => x.id === slug);
  if (!l) throw new Error(`Teaching page ${page.id} links to missing lesson "${slug}"`);
  return l;
});
const pageProcesses = d.processes.map((id) => {
  const p = processes.find((x) => x.id === id);
  if (!p) throw new Error(`Teaching page ${page.id} links to missing process "${id}"`);
  return p;
});
---

<Base title={d.title} description={d.tagline}>
  <article class="type-page">
    <p class="muted"><a href="/teaching/">Teaching</a></p>
    <h1>{d.title}</h1>
    <p class="lede">{d.tagline}</p>

    <ChecksBox checks={d.checks} />

    <div class="lesson-body"><Content /></div>

    <ImageCards page={`teaching/${page.id}`} />

    {pageProcesses.length > 0 && (
      <>
        <h2>Processes that suit this</h2>
        <div class="card-grid compact">
          {pageProcesses.map((p) => (
            <a class="grid-card" href={processUrl(p.id)}>
              <p class="grid-card-meta">{families.find((f) => f.id === p.id.split('/')[0])!.data.title}</p>
              <h3>{p.data.title}</h3>
              <p class="grid-card-note">{p.data.tagline}</p>
            </a>
          ))}
        </div>
      </>
    )}

    {pageLessons.length > 0 && (
      <>
        <h2>Lessons that fit</h2>
        <div class="card-grid">{pageLessons.map((l) => <LessonCard entry={l} entries={lessons} />)}</div>
      </>
    )}

    <SourceCards sources={d.sources} owner={`teaching/${page.id}`} />

    <nav class="part-nav no-print" aria-label="Other teaching pages">
      {prev ? <a href={`/teaching/${prev.id}/`}>← {prev.data.title}</a> : <a href="/teaching/">← Teaching</a>}
      {next ? <a href={`/teaching/${next.id}/`}>{next.data.title} →</a> : <span></span>}
    </nav>
  </article>
</Base>
