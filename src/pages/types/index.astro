---
import Base from '../../layouts/Base.astro';
import FamilyDiagram from '../../components/FamilyDiagram.astro';
import { allTypes, familyUrl, processUrl, processFamily, type FamilyId } from '../../lib/types';

const { families, processes } = await allTypes();
---

<Base
  title="Types of printmaking"
  description="Relief, intaglio, planographic, and stencil: how each family of printmaking works, and the processes within it."
>
  <h1>Types of printmaking</h1>
  <p class="lede">
    Every printmaking process belongs to one of four families, sorted by where the ink sits on the plate. Each family
    page explains how it works and lists the processes within it, with notes on ages, safety, and the plates, presses,
    and inks a classroom can use.
  </p>
  {families.map((f) => (
    <section class="types-family">
      <div class="types-family-head">
        <FamilyDiagram family={f.id as FamilyId} />
        <div>
          <h2><a href={familyUrl(f.id)}>{f.data.title}</a></h2>
          <p class="muted">{f.data.tagline}</p>
        </div>
      </div>
      <ul class="process-links">
        {processes
          .filter((p) => processFamily(p) === f.id)
          .map((p) => (
            <li><a href={processUrl(p.id)}>{p.data.title}</a></li>
          ))}
      </ul>
    </section>
  ))}
</Base>
