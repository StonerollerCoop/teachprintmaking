---
import Base from '../../../layouts/Base.astro';
import { render } from 'astro:content';
import { ageBands } from '../../../data/vocab';
import LessonCard from '../../../components/LessonCard.astro';
import TimelineCards from '../../../components/TimelineCards.astro';
import SourceCards from '../../../components/SourceCards.astro';
import { allLessons } from '../../../lib/lessons';
import {
  allTypes,
  familyUrl,
  processUrl,
  processFamily,
  processSlug,
  pressLabels,
  settingLabels,
  type ProcessEntry,
} from '../../../lib/types';

export async function getStaticPaths() {
  const { processes } = await allTypes();
  return processes.map((p) => {
    const siblings = processes.filter((s) => processFamily(s) === processFamily(p));
    const i = siblings.indexOf(p);
    return {
      params: { family: processFamily(p), process: processSlug(p) },
      props: { proc: p, prev: siblings[i - 1], next: siblings[i + 1] },
    };
  });
}

interface Props {
  proc: ProcessEntry;
  prev?: ProcessEntry;
  next?: ProcessEntry;
}
const { proc, prev, next } = Astro.props;
const d = proc.data;
const { Content } = await render(proc);
const { families, processes } = await allTypes();
const family = families.find((f) => f.id === processFamily(proc))!;
const allEntries = await allLessons();
const lessons = allEntries.filter((l) => !l.data.parent && d.techniques.includes(l.data.technique));
const related = d.related.map((r) => processes.find((p) => p.id === r)!);
---

<Base title={d.title} description={d.tagline}>
  <article class="type-page">
    <p class="muted">
      <a href="/types/">Types of printmaking</a> · <a href={familyUrl(family.id)}>{family.data.title}</a>
    </p>
    <h1>{d.title}</h1>
    <p class="lede">{d.tagline}</p>

    <dl class="facts">
      <dt>Youngest</dt><dd>{ageBands[d.youngest].label}: {d.youngestNote}</dd>
      <dt>Press</dt><dd>{pressLabels[d.press]}</dd>
      <dt>Setting</dt><dd>{settingLabels[d.setting]}</dd>
    </dl>

    <div class="lesson-body"><Content /></div>

    <h2>Lessons on this site</h2>
    {lessons.length === 0 ? (
      <p>None yet.</p>
    ) : (
      <div class="card-grid">{lessons.map((l) => <LessonCard entry={l} entries={allEntries} />)}</div>
    )}

    {related.length > 0 && (
      <>
        <h2>Related processes</h2>
        <div class="card-grid compact">
          {related.map((r) => (
            <a class="grid-card" href={processUrl(r.id)}>
              <p class="grid-card-meta">{families.find((f) => f.id === r.id.split('/')[0])!.data.title}</p>
              <h3>{r.data.title}</h3>
              <p class="grid-card-note">{r.data.tagline}</p>
            </a>
          ))}
        </div>
      </>
    )}

    <TimelineCards ids={d.timeline} />

    <SourceCards sources={d.sources} owner={proc.id} />

    <nav class="part-nav no-print" aria-label={`Other ${family.data.title.toLowerCase()} processes`}>
      {prev ? <a href={processUrl(prev.id)}>← {prev.data.title}</a> : <a href={familyUrl(family.id)}>← {family.data.title}</a>}
      {next ? <a href={processUrl(next.id)}>{next.data.title} →</a> : <span></span>}
    </nav>
  </article>
</Base>
