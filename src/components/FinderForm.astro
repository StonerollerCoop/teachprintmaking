---
/**
 * The classroom form, written as a sentence a teacher fills in. Shared by the
 * home page (which sends you to the Find page) and the Find page (which
 * updates results as you change it). Field names are the contract with
 * src/pages/find.astro; change them together.
 */
import { materials, tools, surfaces, type MaterialId, type ToolId } from '../data/vocab';

interface Props {
  variant: 'home' | 'find';
}
const { variant } = Astro.props;

const materialGroups: { label: string; items: MaterialId[] }[] = [
  { label: 'Inks and paints', items: ['water-block-ink', 'oil-block-ink', 'intaglio-ink', 'fabric-ink', 'tempera', 'acrylic', 'watercolor', 'gum-arabic'] },
  { label: 'Plates and blocks', items: ['foam-sheets', 'linoleum', 'soft-cut-block', 'gel-plate', 'gelatin-glycerin', 'acetate-plate', 'cardboard'] },
  { label: 'Paper and cloth', items: ['print-paper', 'cardstock', 'tissue-paper', 'blank-totes'] },
  { label: 'Found and extra', items: ['texture-scraps', 'leaves', 'produce', 'found-objects', 'string', 'tubes', 'fish', 'sponges', 'cotton-swabs'] },
];
const toolGroups: { label: string; items: ToolId[] }[] = [
  { label: 'Inking and pressing', items: ['brayer', 'inking-slab', 'brushes', 'barren', 'press'] },
  { label: 'Cutting and carving', items: ['carving-tools', 'bench-hook', 'scissors', 'craft-knife', 'etching-needle'] },
  { label: 'Screens, setup, and drying', items: ['screen-squeegee', 'registration-jig', 'drying-rack', 'soaking-tray', 'pans', 'kettle'] },
];
const assumed = (Object.keys(materials) as MaterialId[]).filter((m) => materials[m].assumed);
const short: Partial<Record<string, string>> = {
  'water-block-ink': 'Water-based block ink',
  'oil-block-ink': 'Oil-based relief ink',
  'intaglio-ink': 'Intaglio ink',
  'fabric-ink': 'Fabric screen ink',
  'foam-sheets': 'Foam sheets or trays',
  'soft-cut-block': 'Soft-cut blocks',
  'acetate-plate': 'Acetate or plexiglass',
  cardboard: 'Chipboard or cereal boxes',
  'print-paper': 'Printmaking paper',
  cardstock: 'Cardstock',
  'blank-totes': 'Totes or fabric',
  'texture-scraps': 'Texture scraps',
  'carving-tools': 'Carving gouges',
  'etching-needle': 'Etching needles',
  'screen-squeegee': 'Screens and squeegees',
  'registration-jig': 'Registration jig',
  'soaking-tray': 'Paper-soaking tray',
  barren: 'Baren or spoon',
  brayer: 'Brayers',
  'inking-slab': 'Inking slabs',
  press: 'A printing press',
  'gelatin-glycerin': 'Gelatin and glycerin',
  produce: 'Fruits and vegetables',
  'found-objects': 'Found objects',
  string: 'String or yarn',
  tubes: 'Cardboard tubes or cans',
  fish: 'A whole fish',
  watercolor: 'Watercolor',
  'gum-arabic': 'Gum arabic',
  pans: 'Baking pans',
  kettle: 'Kettle or microwave',
  brushes: 'Paintbrushes',
};
const label = (id: string, fallback: string) => short[id] ?? fallback;
---

<form id="finder" class={`finder-form ${variant}`} action="/find/" method="get" autocomplete="off">
  <div class="ff-basics">
    <fieldset>
      <legend>Your class</legend>
      <label for="ff-students">Number of students
        <input id="ff-students" type="number" name="students" min="1" max="200" inputmode="numeric" />
      </label>
      <label for="ff-ages">Grade or age
        <select id="ff-ages" name="ages">
          <option value="">Any</option>
          <option value="prek">Pre-K</option>
          <option value="k2">Grades K to 2</option>
          <option value="g35">Grades 3 to 5</option>
          <option value="g68">Grades 6 to 8</option>
          <option value="g912">Grades 9 to 12</option>
          <option value="adult">College and adult</option>
        </select>
      </label>
      <label for="ff-exp">Experience
        <select id="ff-exp" name="experience">
          <option value="">Any</option>
          <option value="first">First time printing</option>
          <option value="beginner">Beginner</option>
          <option value="intermediate">Intermediate</option>
          <option value="advanced">Advanced</option>
        </select>
      </label>
    </fieldset>

    <fieldset>
      <legend>Your time</legend>
      <label for="ff-minutes">Minutes per class
        <input id="ff-minutes" type="number" name="minutes" min="10" max="600" step="5" inputmode="numeric" />
      </label>
      <label for="ff-sessions">Number of classes
        <input id="ff-sessions" type="number" name="sessions" min="1" max="30" inputmode="numeric" />
      </label>
    </fieldset>

    <fieldset>
      <legend>Your room</legend>
      <label for="ff-sink">Sink
        <select id="ff-sink" name="sink">
          <option value="">Doesn't matter</option>
          <option value="yes">We have a sink</option>
          <option value="no">No sink</option>
        </select>
      </label>
      <label for="ff-table">Table space
        <select id="ff-table" name="tableSpace">
          <option value="">Any</option>
          <option value="tight">Desks only</option>
          <option value="standard">Classroom tables</option>
          <option value="roomy">Studio tables</option>
        </select>
      </label>
      <label for="ff-mess">Mess we can handle
        <select id="ff-mess" name="maxMess">
          <option value="">Any</option>
          <option value="low">A little</option>
          <option value="medium">Some</option>
          <option value="high">A lot</option>
        </select>
      </label>
      <label for="ff-vent">Ventilation
        <select id="ff-vent" name="ventilation">
          <option value="">Doesn't matter</option>
          <option value="yes">Good</option>
          <option value="no">Poor</option>
        </select>
      </label>
    </fieldset>
  </div>

  <details class="ff-more">
    <summary>
      <span class="ff-more-title">What do you have to print with?</span>
      <span class="ff-more-note">Optional. Once you choose anything here, we'll treat what you didn't choose as something you don't have.</span>
    </summary>
    <div class="ff-more-body">
      <p class="hint">We assume every room has {assumed.map((m) => materials[m].label.toLowerCase()).join(', ')}.</p>
      {materialGroups.map((g) => (
        <fieldset class="ff-group">
          <legend>{g.label}</legend>
          <div class="ff-chips">
            {g.items.map((m) => (
              <label class="ff-chip"><input type="checkbox" name="materials" value={m} /><span>{label(m, materials[m].label)}</span></label>
            ))}
          </div>
        </fieldset>
      ))}
      {toolGroups.map((g) => (
        <fieldset class="ff-group">
          <legend>{g.label}</legend>
          <div class="ff-chips">
            {g.items.map((t) => (
              <label class="ff-chip"><input type="checkbox" name="tools" value={t} /><span>{label(t, tools[t].label)}</span></label>
            ))}
          </div>
        </fieldset>
      ))}
      <fieldset class="ff-group">
        <legend>We can print on</legend>
        <div class="ff-chips">
          {Object.entries(surfaces).map(([id, l]) => (
            <label class="ff-chip"><input type="checkbox" name="surfaces" value={id} /><span>{l}</span></label>
          ))}
        </div>
      </fieldset>
      <label class="ff-switch">
        <input type="checkbox" name="noSharp" value="1" />
        <span class="ff-switch-track" aria-hidden="true"></span>
        <span>No sharp tools with this group, whatever we own</span>
      </label>
    </div>
  </details>

  <div class="ff-actions">
    {variant === 'home'
      ? <button type="submit">Find lessons</button>
      : <button type="reset" class="secondary">Start over</button>}
    <span class="hint">Leave anything blank and it won't narrow the list.</span>
  </div>
</form>

<script>
  // Remember the form so the Find page can pick it up even where the address
  // bar can't carry it. Browser storage can be unavailable; the URL still works.
  const form = document.getElementById('finder') as HTMLFormElement | null;
  if (form && form.classList.contains('home')) {
    form.addEventListener('submit', () => {
      try {
        const q = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        for (const [k, v] of Array.from(q.entries())) if (!v) q.delete(k);
        sessionStorage.setItem('tp-finder', q.toString());
      } catch {}
    });
  }
</script>
