{
  // Test copy only. This serves the built static files from ./dist.
  // No custom domain is attached; teachprintmaking.com is untouched.
  "name": "teachprintmaking",
  "compatibility_date": "2026-10-01",
  // Build the site as part of every deploy, so Cloudflare doesn't depend on
  // a separate build command being set in the dashboard.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
